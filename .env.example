# Copy to .env and fill in your CloudAMQP / RabbitMQ Cloud credentials.
# cp .env.example .env

# --- PostgreSQL (local Docker) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- RabbitMQ Cloud (CloudAMQP) ---
# From your CloudAMQP dashboard: Details -> AMQP URL
# Example host: sharp-kangaroo.rmq.cloudamqp.com
RABBITMQ_HOST=your-instance.rmq.cloudamqp.com
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your-username
RABBITMQ_PASSWORD=your-password
RABBITMQ_VHOST=your-vhost

# CloudAMQP typically requires SSL on port 5671
RABBITMQ_SSL_ENABLED=true

# Reservation TTL in milliseconds (5 minutes)
RESERVATION_TTL_MS=300000
